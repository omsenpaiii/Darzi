# Copy to .env.local only if one does not already exist.
# Never commit real database/auth/storage credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DARZI_APP_ORIGIN=http://localhost:3000
DARZI_PUBLIC_LAUNCH=false
DARZI_LOCAL_PREVIEW=false
DARZI_DEMO_DATA=false
DARZI_AUTO_MIGRATE=false
# Explicit one-time schema/settings setup only; never enable during application builds.
DARZI_SETUP_PRODUCTION=false
DARZI_OWNER_EMAIL=
# Comma-separated real Super Admin emails; managed account setup remains separate.
DARZI_OWNER_EMAILS=
# Single-use owner invitations: JSON [{email,hash,expiresAt}], SHA-256 token hashes only.
# Generate securely into ignored deployment config; never commit raw invitation tokens.
DARZI_OWNER_SETUP_INVITES=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DARZI_STORAGE_BUCKET=
# Optional future continuous scene generation; never paste the key in chat.
HEYGEN_API_KEY=
